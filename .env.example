# =============================================================
#  Copy this file to .env and fill in your values:
#      cp .env.example .env && nano .env
#  Keep comments on their own lines (no inline comments).
# =============================================================

# ---------- LLM (the "brain" of the agent) ----------
# Pick ONE provider and set its key.
# Anthropic examples: anthropic:claude-sonnet-5   anthropic:claude-haiku-4-5-20251001
# OpenAI example:     openai:gpt-4o-mini
LLM_MODEL=anthropic:claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- MCP server network settings ----------
# 127.0.0.1 = only reachable from inside this EC2 (recommended).
MCP_HOST=127.0.0.1
WEATHER_PORT=8001
JIRA_PORT=8002
EC2_PORT=8003

# URLs the agent uses to reach the servers
WEATHER_MCP_URL=http://127.0.0.1:8001/mcp
JIRA_MCP_URL=http://127.0.0.1:8002/mcp
EC2_MCP_URL=http://127.0.0.1:8003/mcp

# ---------- Jira Cloud ----------
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# ---------- AWS / EC2 ----------
# On EC2, credentials come automatically from the attached IAM role.
# Do NOT put access keys here when running on EC2.
AWS_REGION=ap-south-1
# Set to true ONLY if you want the agent to start/stop instances.
EC2_ALLOW_WRITE=false
